#include <stdio.h>
#include <stdlib.h>


typedef struct tipoNo {
  int  dado;
  struct tipoNo *prox;
} tipoNo;


typedef struct tipoLista {
  tipoNo * prim;
}tipoLista;

void criar(tipoLista *pLista){
  pLista->prim = NULL;
}
// insere um elemento na última posição
void inserir(tipoLista *pLista, int elemento){
  tipoNo * aux;

  aux = (tipoNo*)  malloc(sizeof(tipoNo));
  aux-> dado = elemento;
  aux->prox = pLista->prim;
  pLista->prim = aux;
}

// APENAS PARA SERVIR DE EXEMPLO, JA TEMOS A MOSTRAR ABAIXO
void mostrarComFor(tipoLista *pLista) {

  tipoNo *aux;

  printf("[ ") ;
  for(aux = pLista->prim; aux != NULL ; aux = aux->prox){ 
    printf("%d ", aux->dado);
  }
  printf("]") ;
}


void concatena(tipoLista *l1,tipoLista *l2) {
  tipoNo *aux;
  if(l1->prim == NULL) {
    l1->prim = l2->prim;
  }
  else {
    aux = l1->prim;
    while(aux->prox) {
      aux = aux->prox;
    }
    aux->prox = l2->prim;
  }
  l2->prim = NULL;
}


void mostrar(tipoLista *pLista) {

  tipoNo *aux;
  aux = pLista->prim;

  printf("[ ") ;
  while(aux != NULL) {  // for(aux = pLista->prim; aux; aux = aux->prox)
    printf("%d ", aux->dado);
    aux = aux->prox;
  }
  printf("]") ;
}

