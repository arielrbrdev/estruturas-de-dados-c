  tipoNo *aux;

  aux = pLista->prim;

  while(aux != NULL) {  // for(aux = pLista->prim; aux; aux = aux->prox)
    if(aux->dado == chave) {
      return 1;
    }
    aux = aux->prox;
  }
    return 0;
}



int maiorValor(tipoLista *pLista, int chave) {

  tipoNo *aux;
  int maior;
  aux = pLista->prim;
  maior = aux->dado;
  aux = aux->prox;
  while(aux != NULL) {  // for(aux = pLista->prim; aux; aux = aux->prox)
    if(aux->dado > maior) {
      maior = aux->dado;
    }
    aux = aux->prox;
  }
  return maior;
}



float mediaDosValores(tipoLista *pLista, int chave) {

  tipoNo *aux;
  float soma = 0;
  unsigned numElementos = 0;
  aux = pLista->prim;
  while(aux != NULL) {  // for(aux = pLista->prim; aux; aux = aux->prox)
    soma = soma + aux->dado;
    numElementos++;
    aux = aux->prox;
  }
  if(numElementos) {
    return soma/numElementos;
  }
  return 0;
}

char listaVazia(tipoLista *pLista) {
  if(pLista->prim) {
    return 0;
  }
  return 1;
}

int remover(tipoLista *pLista, int chave) {

  tipoNo *aux, *temp;

  if(pLista->prim) { // procura a chave se há elmentos
    aux = pLista->prim;
   
    if(aux->dado == chave) {
      // se chave a ser apagada é o primeiro da lista 
      pLista->prim = aux->prox;
      free(aux);
      return 1; // 1 porque indica que apagou
    }
    // aqui já sei que não é a primeia
    // vou ver se é da segunda em diante
    while(aux->prox != NULL) {  // for(aux = pLista->prim; aux; aux = aux->prox)
      if(aux->prox->dado == chave) { // achei a chave para apagar
	temp = aux->prox;
	aux->prox = temp->prox; // "desliga" da lista
	free(temp); // libera a memória
	return 1;
      }
      aux = aux->prox;
    }
  }
  return 0;
}


